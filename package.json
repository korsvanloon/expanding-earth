{
  "name": "expanding-earth",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "A data-driven Expanding Earth reconstruction: the planet's radius is derived from the seafloor age grid, and the continents are moved by a physical solver rather than by hand-authored keyframes.",
  "packageManager": "pnpm@11.24.0",
  "scripts": {
    "data": "tsx tools/run.ts && tsx tools/write-docs.ts",
    "dev": "pnpm run data && vite",
    "build": "tsx tools/run.ts && pnpm bundle",
    "bundle": "tsc -b && vite build",
    "preview": "vite preview",
    "artifact": "pnpm run build && tsx tools/build-artifact.ts",
    "typecheck": "tsc -b && tsc -p tsconfig.tools.json",
    "test": "vitest run",
    "docs": "tsx tools/write-docs.ts"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.6",
    "@react-three/fiber": "^9.3.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "three": "^0.181.0",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/three": "^0.181.0",
    "@vitejs/plugin-react": "^5.0.4",
    "h5wasm": "^0.10.3",
    "jpeg-js": "^0.4.4",
    "pngjs": "^7.0.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^7.1.9",
    "vitest": "^3.2.4"
  }
}
